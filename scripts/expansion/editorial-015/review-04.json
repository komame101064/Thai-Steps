   "senses": [
    {
     "sourceSense": 1,
     "ja": "痛い目を見るまで懲りない・分からない",
     "en": "won't learn until disaster strikes",
     "pos": "定型表現",
     "use": "よく使う意味",
     "registerTags": [],
     "speechStyle": "標準語（口語限定ではない）",
     "example": {
      "th": "บอกแล้วไม่ฟัง ไม่เห็นโลงศพไม่หลั่งน้ำตาจริงๆ",
