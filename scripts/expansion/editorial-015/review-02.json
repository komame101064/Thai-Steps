    "colloquial",
    "slang"
   ],
   "frequency": 5,
   "senses": [
    {
     "sourceSense": 1,
     "ja": "（軽く）酒を飲む・一杯やる",
     "pos": "動詞",
     "speechStyle": "口語・スラング",
     "note": "英語drinkから。友人同士で使う。表記はดริ้งค์・ดริ้งが多く、辞書式はดริงก์。",
     "example": {
      "th": "เย็นนี้ไปดริ้งค์กันไหม",
      "ro": "yen níi pai drîng kan mǎi",
      "ja": "今晩一杯やりに行かない？",
      "context": "仕事帰りに同僚を誘う",
      "origin": "authored"
     }
    }
   ]
  }
