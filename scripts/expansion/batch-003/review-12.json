  ],
  "fixed": {
   "id": "tl-26456",
   "th": "ไซ",
   "action": "add",
   "ro": "sai",
   "kind": "word",
   "category": "一般語彙",
   "senses": [
    {
     "sourceSense": 1,
     "ja": "筌（うけ）・竹で編んだ魚取りのわな",
     "en": "bamboo fish trap",
     "pos": "名詞",
     "use": "よく使う意味",
     "registerTags": [],
