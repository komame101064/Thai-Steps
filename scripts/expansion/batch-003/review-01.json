 {
  "id": "tl-21999",
  "verdict": "fix",
  "issues": [
   "語義2の例文訳「この先の年は」が不自然な日本語のため修正"
  ],
  "fixed": {
   "id": "tl-21999",
   "th": "ต่อๆ",
   "action": "add",
   "ro": "tɔ̀ɔ tɔ̀ɔ",
   "kind": "word",
   "category": "一般語彙",
   "senses": [
    {
     "sourceSense": 1,
     "ja": "次々に（人から人へ）",
     "en": "on and on, from one to the next",
     "pos": "副詞",
     "use": "よく使う意味",
     "registerTags": [],
     "speechStyle": "標準語（口語限定ではない）",
     "example": {
      "th": "ข่าวนี้ถูกส่งต่อๆ กันไป",
      "ro": "khàao níi thùuk sòng tɔ̀ɔ tɔ̀ɔ kan pai",
      "ja": "このニュースは次々と人から人へ伝えられました。",
      "en": "This news was passed on from person to person.",
      "origin": "authored"
     }
    },
    {
     "sourceSense": 2,
     "ja": "（ต่อๆ ไปで）今後の・この先の",
     "en": "(ต่อๆ ไป) following, from now on",
     "pos": "形容詞・状態語",
     "use": "よく使う別の意味",
     "registerTags": [],
     "speechStyle": "標準語（口語限定ではない）",
     "example": {
      "th": "ปีต่อๆ ไปคงจะดีขึ้น",
      "ro": "pii tɔ̀ɔ tɔ̀ɔ pai khong cà dii khʉ̂n",
      "ja": "来年以降はきっと良くなるでしょう。",
      "en": "The coming years will probably be better.",
      "origin": "authored"
     }
    }
   ]
  }
