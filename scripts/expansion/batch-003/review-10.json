   "category": "自然・天気・色",
   "senses": [
    {
     "sourceSense": 1,
     "ja": "（雨などが）激しく降る",
     "en": "to fall heavily (rain)",
     "pos": "動詞",
     "use": "よく使う意味",
     "registerTags": [],
     "speechStyle": "標準語（口語限定ではない）",
     "example": {
      "th": "เมื่อคืนฝนตกหนักมาก",
