  "id": "tl-22887",
  "verdict": "fix",
  "issues": [
   "例文の和訳「取っておいています」が不自然な日本語のため「取ってあります」に修正"
  ],
  "fixed": {
   "id": "tl-22887",
   "th": "ใช้สอย",
   "action": "add",
   "ro": "chái sɔ̌ɔi",
   "kind": "word",
   "category": "お金・買い物",
   "senses": [
    {
     "sourceSense": 1,
     "ja": "（日常の用に）使う・充てる",
     "en": "to use, spend (for everyday needs)",
     "pos": "動詞",
     "use": "よく使う意味",
     "registerTags": [],
     "speechStyle": "標準語（口語限定ではない）",
     "example": {
      "th": "เขาเก็บเงินไว้ใช้สอยยามจำเป็น",
      "ro": "khǎo kèp ngəən wái chái sɔ̌ɔi yaam cam pen",
      "ja": "あの人は必要な時に使うためにお金を取ってあります。",
      "en": "He saves money to use when he needs it.",
      "origin": "authored"
     }
    }
   ]
  }
