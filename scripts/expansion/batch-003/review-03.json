 {
  "id": "tl-23998",
  "verdict": "fix",
  "issues": [
   "เฉลิมพระเกียรติ は特定の王族（多くは国王）をたたえる意で、「王室の栄誉」という訳はややずれる。和訳・英訳を修正"
  ],
  "fixed": {
   "id": "tl-23998",
   "th": "พระเกียรติ",
   "action": "add",
   "ro": "phrá kìiat",
   "kind": "word",
   "category": "社会・制度",
   "senses": [
    {
     "sourceSense": 1,
     "ja": "（国王・王族の）栄誉・威光",
     "en": "honor, prestige (of the king or royalty)",
     "pos": "名詞",
     "use": "よく使う意味",
     "registerTags": [
      "royal"
     ],
     "speechStyle": "王室の敬語",
     "example": {
      "th": "งานนี้จัดขึ้นเพื่อเฉลิมพระเกียรติ",
      "ro": "ngaan níi càt khʉ̂n phʉ̂ʉa chà lə̌əm phrá kìiat",
      "ja": "この催しは王族をたたえるために開かれる。",
      "en": "This event is held to honor royalty.",
      "origin": "authored"
     }
    }
   ],
   "note": "主に เฉลิมพระเกียรติ（王室の栄誉をたたえる）の形で使う。"
  }
