   "category": "仕事・学習",
   "senses": [
    {
     "sourceSense": 1,
     "ja": "座談会・討論会（意見を交わす集まり）",
     "en": "panel discussion, forum",
     "pos": "名詞",
     "use": "よく使う意味",
     "registerTags": [
      "formal"
     ],
     "speechStyle": "改まった表現",
     "example": {
      "th": "งานเสวนาเรื่องสิ่งแวดล้อมจะจัดวันเสาร์",
      "ro": "ngaan sěe wá naa rʉ̂ʉang sìng wɛ̂ɛt lɔ́ɔm cà càt wan sǎo",
      "ja": "環境についての討論会は土曜日に開かれる。",
      "en": "The panel discussion on the environment will be held on Saturday.",
      "origin": "authored"
     }
    }
   ]
  }
