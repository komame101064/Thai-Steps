 {
  "id": "tl-25611",
  "verdict": "fix",
  "issues": [
   "語義の「ちょっと」は แป๊บนึง 全体の意味で นึง 自体の意味ではない",
   "例文 รอแป๊บนึงนะ は既存例文（example-reference）とほぼ重複し「一」の意味が見えにくいため、類別詞＋นึง の例に差し替え"
  ],
  "fixed": {
   "id": "tl-25611",
   "th": "นึง",
   "action": "add",
   "ro": "nʉng",
   "kind": "word",
   "category": "数字",
   "senses": [
    {
     "sourceSense": 1,
     "ja": "一つ・一（หนึ่ง の口語形）",
     "en": "one (colloquial form of หนึ่ง)",
     "pos": "数詞",
     "use": "よく使う意味",
     "registerTags": [
      "colloquial"
     ],
     "speechStyle": "口語",
     "example": {
      "th": "ขอกาแฟแก้วนึงครับ",
      "ro": "khɔ̌ɔ kaa fɛɛ kɛ̂ɛo nʉng khráp",
      "ja": "コーヒーを一杯ください。",
      "en": "One coffee, please.",
      "origin": "authored"
     }
    }
   ],
   "note": "話し言葉で หนึ่ง が軽く発音された形。主に類別詞の後に置く。"
  }
 },
