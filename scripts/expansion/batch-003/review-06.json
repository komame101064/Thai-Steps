 {
  "id": "tl-25488",
  "verdict": "fix",
  "issues": [
   "例文訳の時制・構文を原文（ได้รับ…เป็นคำรบสอง＝二度目に受けた）に合わせた。เป็นคำรบสอง は改まった書き言葉として自然"
  ],
  "fixed": {
   "id": "tl-25488",
   "th": "คำรบ",
   "action": "add",
   "ro": "kham róp",
   "kind": "word",
   "category": "数え方",
   "senses": [
    {
     "sourceSense": 1,
     "ja": "〜回目・〜度目",
     "en": "time (ordinal occurrence)",
     "pos": "名詞",
     "use": "よく使う意味",
     "registerTags": [
      "formal"
     ],
     "speechStyle": "改まった表現",
     "example": {
      "th": "เขาได้รับรางวัลนี้เป็นคำรบสอง",
      "ro": "khǎo dâai ráp raang wan níi pen kham róp sɔ̌ɔng",
      "ja": "彼はこの賞を二度目に受賞した。",
      "en": "He received this award for the second time.",
      "origin": "authored"
     }
    }
   ],
   "note": "主に เป็นคำรบ＋数 の形で書き言葉に使う。"
  }
 },
