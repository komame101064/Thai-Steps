   "action": "add",
   "ro": "ní khom",
   "kind": "word",
   "category": "家・場所",
   "senses": [
    {
     "sourceSense": 1,
     "ja": "（工業団地などの）区域・入植地",
     "en": "settlement, estate (e.g. industrial estate)",
     "pos": "名詞",
     "use": "よく使う意味",
     "registerTags": [],
