  "verdict": "fix",
  "issues": [
   "読み chà lə̌əm phrá chon má phan sǎa は辞書の読み（ชน-มะ-พัน-สา）として妥当だが、ชน-นะ-พัน-สา の読みも広く通用するため注記に追加"
  ],
  "fixed": {
   "id": "tl-26426",
   "th": "เฉลิมพระชนมพรรษา",
   "action": "add",
   "ro": "chà lə̌əm phrá chon má phan sǎa",
   "kind": "word",
   "category": "社会・制度",
   "senses": [
    {
     "sourceSense": 1,
     "ja": "（国王・王妃の）誕生日を祝うこと・ご誕生日",
     "en": "celebration of the King's or Queen's birthday",
     "pos": "名詞",
     "use": "よく使う意味",
     "registerTags": [
      "royal"
     ],
     "speechStyle": "王室の敬語",
     "example": {
      "th": "ประชาชนร่วมจุดเทียนถวายพระพรในวันเฉลิมพระชนมพรรษา",
      "ro": "prà chaa chon rûuam cùt thiian thà wǎai phrá phɔɔn nai wan chà lə̌əm phrá chon má phan sǎa",
      "ja": "国民は国王誕生日に共にろうそくを灯して祝福を捧げた。",
      "en": "People lit candles together to offer blessings on the King's birthday.",
      "origin": "authored"
     }
    }
   ],
   "note": "วันเฉลิมพระชนมพรรษา（国王・王妃の誕生日）の形で使う王室語。ชนม は「chon ná」と読む人も多い。"
  }
