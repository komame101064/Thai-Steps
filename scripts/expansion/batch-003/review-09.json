   "category": "家・場所",
   "senses": [
    {
     "sourceSense": 1,
     "ja": "（タイの）南部地方",
     "en": "the South (of Thailand)",
     "pos": "名詞",
     "use": "よく使う意味",
     "registerTags": [],
     "speechStyle": "標準語（口語限定ではない）",
     "example": {
      "th": "อาหารปักษ์ใต้ส่วนใหญ่มีรสเผ็ด",
      "ro": "aa hǎan pàk tâi sùuan yài mii rót phèt",
      "ja": "南部の料理はたいてい辛い。",
