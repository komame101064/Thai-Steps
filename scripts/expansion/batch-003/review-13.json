 {
  "id": "tl-26586",
  "verdict": "fix",
  "issues": [
   "注記が「口出しする」の意味だけが失礼と読めるが、現代ではこの語自体が粗い語として受け取られやすいため注記を修正"
  ],
  "fixed": {
   "id": "tl-26586",
   "th": "เสือก",
   "action": "add",
   "ro": "sʉ̀ʉak",
   "kind": "word",
   "category": "一般語彙",
   "senses": [
    {
     "sourceSense": 1,
     "ja": "首を突っ込む・余計な口出しをする",
     "en": "to butt in, be nosy",
     "pos": "動詞",
     "use": "よく使う意味",
     "registerTags": [
      "colloquial",
      "vulgar"
     ],
     "speechStyle": "粗い口語",
     "example": {
      "th": "เรื่องของฉัน ไม่ต้องเสือก",
      "ro": "rʉ̂ʉang khɔ̌ɔng chǎn mâi tɔ̂ɔng sʉ̀ʉak",
      "ja": "私のことだ、首を突っ込むな。",
      "en": "It's my business, butt out.",
      "origin": "authored"
     }
    },
    {
     "sourceSense": 2,
     "ja": "押しやる・突き出す",
     "en": "to push, shove (forward)",
     "pos": "動詞",
     "use": "少なめの用法",
     "registerTags": [
      "literary"
     ],
     "speechStyle": "文語",
     "example": {
      "th": "เขาเสือกจานข้าวไปเบื้องหน้าด้วยความรู้สึกเบื่อหน่าย",
      "ro": "khǎo sʉ̀ʉak caan khâao pai bʉ̂ʉang nâa dûuai khwaam rúu sʉ̀k bʉ̀ʉa nàai",
      "ja": "彼はうんざりした気持ちでご飯の皿を前へ押しやった。",
      "en": "He pushed his plate forward, fed up.",
      "origin": "source"
     }
    }
   ],
   "note": "現代では主に「口出しする」の意味の非常に失礼な語として使われるため、他の意味でも使う場面に注意。"
  }
 },
