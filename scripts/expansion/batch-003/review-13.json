   "action": "add",
   "ro": "phɛ̀ɛ mêet taa",
   "kind": "expression",
   "category": "社会・制度",
   "senses": [
    {
     "sourceSense": 1,
     "ja": "慈しみの心を送る（仏教）",
     "en": "to extend loving-kindness (Buddhism)",
     "pos": "動詞",
     "use": "よく使う意味",
     "registerTags": [],
     "speechStyle": "標準語（口語限定ではない）",
     "example": {
      "th": "เราควรฝึกแผ่เมตตาให้ผู้อื่นแล้วชีวิตจะมีความสุข",
      "ro": "rao khuuan fʉ̀k phɛ̀ɛ mêet taa hâi phûu ʉ̀ʉn lɛ́ɛo chii wít cà mii khwaam sùk",
      "ja": "私たちは他人に慈しみの心を送る練習をするべきだ。そうすれば人生は幸せになる。",
      "en": "We should practice extending loving-kindness to others, and life will be happy.",
      "origin": "source"
     }
    }
   ]
  }
