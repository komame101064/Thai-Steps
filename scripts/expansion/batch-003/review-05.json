 {
  "id": "tl-25034",
  "verdict": "fix",
  "issues": [
   "語義1「すいすいと速く」（รถวิ่งฉิว・ฉิวเลย）は話し言葉の擬態的副詞なので口語ラベルに変更",
   "語義2「むっとする」は実在するがやや古めで頻度は低いため use を少なめの用法に変更（語義・用例自体は可）"
  ],
  "fixed": {
   "id": "tl-25034",
   "th": "ฉิว",
   "action": "add",
   "ro": "chǐu",
   "kind": "word",
   "category": "一般語彙",
   "senses": [
    {
     "sourceSense": 1,
     "ja": "（風を切って）すいすいと・速く",
     "en": "swiftly, zooming",
     "pos": "副詞",
     "use": "よく使う意味",
     "registerTags": [
      "colloquial"
     ],
     "speechStyle": "口語",
     "example": {
      "th": "รถวิ่งฉิวไปบนถนน",
      "ro": "rót wîng chǐu pai bon thà nǒn",
      "ja": "車が道路をすいすいと走っていきました。",
      "en": "The car zoomed along the road.",
      "origin": "authored"
     }
    },
    {
     "sourceSense": 2,
     "ja": "むっとする・腹を立てる",
     "en": "to be miffed, get angry",
     "pos": "形容詞・状態語",
     "use": "少なめの用法",
     "registerTags": [
      "colloquial"
     ],
     "speechStyle": "口語",
     "example": {
      "th": "เธอฉิวมากที่ฉันมาสาย",
      "ro": "thəə chǐu mâak thîi chǎn maa sǎai",
      "ja": "私が遅れて来たので、あの人はとてもむっとしました。",
      "en": "She was really annoyed that I came late.",
      "origin": "authored"
     }
    }
   ]
  }
 },
