 {
  "id": "tl-25091",
  "verdict": "fix",
  "issues": [
   "例文「เชื่อแน่แท้ว่า…」は不自然な結びつきで和訳もぎこちないため、典型的な「เป็นความจริงอย่างแน่แท้」の文に差し替え。文語ラベルは妥当"
  ],
  "fixed": {
   "id": "tl-25091",
   "th": "แน่แท้",
   "action": "add",
   "ro": "nɛ̂ɛ thɛ́ɛ",
   "kind": "word",
   "category": "一般語彙",
   "senses": [
    {
     "sourceSense": 1,
     "ja": "確かに・間違いなく",
     "en": "surely, certainly",
     "pos": "副詞",
     "use": "よく使う意味",
     "registerTags": [
      "literary"
     ],
     "speechStyle": "文語",
     "example": {
      "th": "เรื่องนี้เป็นความจริงอย่างแน่แท้",
      "ro": "rʉ̂ʉang níi pen khwaam cing yàang nɛ̂ɛ thɛ́ɛ",
      "ja": "この話は確かに本当です。",
      "en": "This story is certainly true.",
      "origin": "authored"
     }
    }
   ]
  }
 },
