 {
  "id": "tl-26788",
  "verdict": "fix",
  "issues": [
   "読み khá rá hǎa（王立学士院の標準読み）は妥当、khɔɔ rá hǎa の異読注記も可",
   "例文訳「不正な目的に」は ผิดประเภท（用途違い・目的外）より強すぎるため修正"
  ],
  "fixed": {
   "id": "tl-26788",
   "th": "ครหา",
   "action": "add",
   "ro": "khá rá hǎa",
   "kind": "word",
   "category": "社会・制度",
   "senses": [
    {
     "sourceSense": 1,
     "ja": "非難する・とがめる（うわさ・世間が）",
     "en": "to criticize, censure",
     "pos": "動詞",
     "use": "よく使う意味",
     "registerTags": [
      "formal"
     ],
     "speechStyle": "改まった表現",
     "example": {
      "th": "เขาถูกครหาว่าใช้เงินผิดประเภท",
      "ro": "khǎo thùuk khá rá hǎa wâa chái ngən phìt prà phêet",
      "ja": "彼はお金を目的外に使ったと非難された。",
      "en": "He was criticized for misusing the money.",
      "origin": "authored"
     }
    }
   ],
   "note": "「khɔɔ rá hǎa」とも読む。名詞「คำครหา（非難）」でもよく使う。"
  }
 },
