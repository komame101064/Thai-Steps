 {
  "id": "tl-26786",
  "verdict": "fix",
  "issues": [
   "ยุติ はro-lexiconで yút tì（標準読みもユット・ティ）。見出し・例文のroを khɔ̂ɔ yút tì に修正"
  ],
  "fixed": {
   "id": "tl-26786",
   "th": "ข้อยุติ",
   "action": "add",
   "ro": "khɔ̂ɔ yút tì",
   "kind": "word",
   "category": "社会・制度",
   "senses": [
    {
     "sourceSense": 1,
     "ja": "結論・決着",
     "en": "conclusion, settlement",
     "pos": "名詞",
     "use": "よく使う意味",
     "registerTags": [
      "formal"
     ],
     "speechStyle": "改まった表現",
     "example": {
      "th": "ทั้งสองฝ่ายยังไม่ได้ข้อยุติ",
      "ro": "tháng sɔ̌ɔng fàai yang mâi dâai khɔ̂ɔ yút tì",
      "ja": "双方はまだ決着に至っていない。",
      "en": "Both sides have not reached a settlement yet.",
      "origin": "authored"
     }
    }
   ]
  }
 },
