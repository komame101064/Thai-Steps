  ],
  "fixed": {
   "id": "tl-26840",
   "th": "ย่ำยี",
   "action": "add",
   "ro": "yâm yii",
   "kind": "word",
   "category": "一般語彙",
   "senses": [
    {
     "sourceSense": 1,
     "ja": "踏みにじる・蹂躙する",
     "en": "to trample on, violate, oppress",
     "pos": "動詞",
     "use": "よく使う意味",
     "registerTags": [
      "formal"
     ],
     "speechStyle": "改まった表現",
     "example": {
      "th": "คำพูดของเขาย่ำยีจิตใจฉัน",
