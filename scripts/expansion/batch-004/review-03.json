  ],
  "fixed": {
   "id": "tl-27497",
   "th": "เมษ",
   "action": "add",
   "ro": "mêet",
   "kind": "word",
   "category": "時間",
   "senses": [
    {
     "sourceSense": 1,
     "ja": "牡羊座（ราศีเมษ）",
     "en": "Aries",
     "pos": "名詞",
     "use": "よく使う意味",
     "registerTags": [],
     "speechStyle": "標準語（口語限定ではない）",
     "example": {
      "th": "น้องสาวของฉันเป็นคนราศีเมษ",
      "ro": "nɔ́ɔng sǎao khɔ̌ɔng chǎn pen khon raa sǐi mêet",
      "ja": "私の妹は牡羊座です。",
      "en": "My younger sister is an Aries.",
      "origin": "authored"
     }
    },
    {
     "sourceSense": 2,
     "ja": "4月（เมษายนのくだけた略し方）",
     "en": "April (short for เมษายน)",
     "pos": "名詞",
     "use": "少なめの用法",
     "registerTags": [
      "colloquial"
     ],
     "speechStyle": "口語",
     "example": {
      "th": "เดือนเมษร้อนที่สุดในปี",
      "ro": "dʉʉan mêet rɔ́ɔn thîi sùt nai pii",
      "ja": "4月は一年でいちばん暑い。",
      "en": "April is the hottest month of the year.",
      "origin": "authored"
     }
    }
   ]
  }
