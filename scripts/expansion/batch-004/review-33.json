 {
  "id": "tl-27040",
  "verdict": "fix",
  "issues": [
   "語義2（ไม่อั้น＝制限なく）は副詞的用法なので pos を副詞に修正。語義・例文は妥当"
  ],
  "fixed": {
   "id": "tl-27040",
   "th": "อั้น",
   "action": "add",
   "ro": "ân",
   "kind": "word",
   "category": "体・健康",
   "senses": [
    {
     "sourceSense": 1,
     "ja": "（尿・息などを）こらえる・我慢する",
     "en": "to hold back, hold in (urine, breath)",
     "pos": "動詞",
     "use": "よく使う意味",
     "registerTags": [],
     "speechStyle": "標準語（口語限定ではない）",
     "example": {
      "th": "คนไข้อั้นปัสสาวะไว้ไม่อยู่",
      "ro": "khon khâi ân pàt sǎa wá wái mâi yùu",
      "ja": "患者は尿をこらえきれなかった。",
      "en": "The patient could not hold his urine.",
      "origin": "source"
     }
    },
    {
     "sourceSense": 2,
     "ja": "（ไม่อั้นの形で）制限なく・いくらでも",
     "en": "(in ไม่อั้น) without limit, as much as one likes",
     "pos": "副詞",
     "use": "よく使う別の意味",
     "registerTags": [
      "colloquial"
     ],
     "speechStyle": "口語",
     "example": {
      "th": "ร้านนี้เติมน้ำได้ไม่อั้น",
      "ro": "ráan níi təəm náam dâai mâi ân",
      "ja": "この店は飲み物を何杯でもおかわりできる。",
      "en": "At this shop you can get unlimited refills.",
      "origin": "authored"
     }
    }
   ]
  }
 },
