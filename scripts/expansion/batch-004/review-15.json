  "id": "tl-28833",
  "verdict": "fix",
  "issues": [
   "国王の行幸には「เสด็จพระราชดำเนิน」を使う（เสด็จไป は他の王族向け）。例文の敬語を修正"
  ],
  "fixed": {
   "id": "tl-28833",
   "th": "พระราชกุศล",
   "action": "add",
   "ro": "phrá râat chá kù sǒn",
   "kind": "word",
   "category": "社会・制度",
   "senses": [
    {
     "sourceSense": 1,
     "ja": "（国王・王族が行う）功徳の儀式",
     "en": "royal merit-making",
     "pos": "名詞",
     "use": "よく使う意味",
     "registerTags": [
      "royal"
     ],
     "speechStyle": "王室の敬語",
     "example": {
      "th": "พระเจ้าอยู่หัวเสด็จพระราชดำเนินไปทรงบำเพ็ญพระราชกุศลที่วัด",
      "ro": "phrá câao yùu hǔua sà dèt phrá râat chá dam nəən pai song bam phen phrá râat chá kù sǒn thîi wát",
      "ja": "国王は寺へお出ましになり、功徳の儀式を執り行われた。",
      "en": "The King went to the temple to perform a royal merit-making ceremony.",
      "origin": "authored"
     },
     "note": "王室の行事にだけ使い、「ทรงบำเพ็ญพระราชกุศล」の形が多い。"
    }
   ]
  }
