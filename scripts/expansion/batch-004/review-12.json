  "verdict": "fix",
  "issues": [
   "น้ำพระราชหฤทัย は国王だけでなく王妃にも使うため注記を修正。王室語の文法・例文は可"
  ],
  "fixed": {
   "id": "tl-28486",
   "th": "น้ำพระทัย",
   "action": "add",
   "ro": "nám phrá thai",
   "kind": "word",
   "category": "社会・制度",
   "senses": [
    {
     "sourceSense": 1,
     "ja": "（王族の）ご厚意・お心遣い",
     "en": "kindness, goodwill (of a royal)",
     "pos": "名詞",
     "use": "よく使う意味",
     "registerTags": [
      "royal"
     ],
     "speechStyle": "王室の敬語",
     "example": {
      "th": "ประชาชนซาบซึ้งในน้ำพระทัยของพระองค์",
      "ro": "prà chaa chon sâap sʉ́ng nai nám phrá thai khɔ̌ɔng phrá ong",
      "ja": "人々はその方のご厚意に深く感謝した。",
      "en": "The people were deeply grateful for the royal's kindness.",
      "origin": "authored"
     },
     "note": "国王・王妃以外の王族に使い、国王・王妃には น้ำพระราชหฤทัย を使う。"
    }
   ]
  }
