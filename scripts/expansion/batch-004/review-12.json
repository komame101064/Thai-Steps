  ],
  "fixed": {
   "id": "tl-28472",
   "th": "ทันตา",
   "action": "add",
   "ro": "than taa",
   "kind": "word",
   "category": "時間",
   "senses": [
    {
     "sourceSense": 1,
     "ja": "たちどころに・すぐ目の前で（結果が出る）",
     "en": "immediately, before one's eyes",
     "pos": "副詞",
     "use": "よく使う意味",
     "registerTags": [],
     "speechStyle": "標準語（口語限定ではない）",
     "example": {
      "th": "ยานี้กินแล้วเห็นผลทันตา",
      "ro": "yaa níi kin lɛ́ɛo hěn phǒn than taa",
      "ja": "この薬は飲むとたちどころに効果が出る。",
      "en": "This medicine shows results right away.",
      "origin": "authored"
     },
     "note": "เห็นผลทันตา（すぐ効果が見える）の形でよく使う。"
    }
   ]
  }
