   "th": "ผู้ว่า",
   "action": "add",
   "ro": "phûu wâa",
   "kind": "word",
   "category": "社会・制度",
   "senses": [
    {
     "sourceSense": 1,
     "ja": "県知事",
     "en": "(provincial) governor",
     "pos": "名詞",
     "use": "よく使う意味",
     "registerTags": [],
     "speechStyle": "標準語（口語限定ではない）",
