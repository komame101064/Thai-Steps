  ],
  "fixed": {
   "id": "tl-28578",
   "th": "ล่วงละเมิด",
   "action": "add",
   "ro": "lûuang lá mə̂ət",
   "kind": "word",
   "category": "社会・制度",
   "senses": [
    {
     "sourceSense": 1,
     "ja": "（権利・規則を）侵害する・犯す",
     "en": "to violate, infringe",
     "pos": "動詞",
     "use": "よく使う意味",
     "registerTags": [
      "formal"
     ],
     "speechStyle": "改まった表現",
     "example": {
      "th": "ไม่มีใครมีสิทธิ์ล่วงละเมิดสิทธิของผู้อื่น",
      "ro": "mâi mii khrai mii sìt lûuang lá mə̂ət sìt thí khɔ̌ɔng phûu ʉ̀ʉn",
      "ja": "他人の権利を侵害する権利は誰にもない。",
      "en": "No one has the right to violate the rights of others.",
      "origin": "authored"
     }
    },
    {
     "sourceSense": 2,
     "ja": "（多く ทางเพศ を伴い）性的虐待をする・わいせつ行為をする",
     "en": "to sexually abuse",
     "pos": "動詞",
     "use": "よく使う別の意味",
     "registerTags": [
      "formal"
     ],
     "speechStyle": "改まった表現",
     "example": {
      "th": "ชายคนนี้ถูกจับข้อหาล่วงละเมิดทางเพศเด็ก",
      "ro": "chaai khon níi thùuk càp khɔ̂ɔ hǎa lûuang lá mə̂ət thaang phêet dèk",
      "ja": "この男は子どもへの性的虐待の容疑で逮捕された。",
      "en": "This man was arrested on charges of sexually abusing children.",
      "origin": "authored"
     },
     "note": "この意味では「ล่วงละเมิดทางเพศ」の形で使う。"
    }
   ]
  }
