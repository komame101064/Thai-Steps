  "issues": [
   "ดื้อๆ の中心は「理由・断り・手順なしに平然と」で、「いきなり（突然）」を主訳にすると意味がずれるため語義・訳を修正"
  ],
  "fixed": {
   "id": "tl-27594",
   "th": "ดื้อๆ",
   "action": "add",
   "ro": "dʉ̂ʉ dʉ̂ʉ",
   "kind": "word",
   "category": "性質・状態",
   "senses": [
    {
     "sourceSense": 1,
     "ja": "（理由も断りもなく）あっさり・平然と",
     "en": "just like that, without reason or ceremony",
     "pos": "副詞",
     "use": "よく使う意味",
     "registerTags": [
      "colloquial"
     ],
     "speechStyle": "口語",
     "example": {
      "th": "เขาลาออกไปดื้อๆ",
      "ro": "khǎo laa ɔ̀ɔk pai dʉ̂ʉ dʉ̂ʉ",
      "ja": "彼は何の理由もなくあっさり辞めてしまった。",
      "en": "He just quit, just like that, for no reason.",
      "origin": "authored"
     }
    }
   ]
  }
