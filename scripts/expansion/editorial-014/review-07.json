  "issues": [
   "「子どもを迎えに行く」だけでは รับ＋ลูก の自由な組み合わせ。慣用の意味（提案・発言を受けて応じる、報道で多用）を注記から語義2に移し用例を追加"
  ],
  "fixed": {
   "id": "tl-57087",
   "th": "รับลูก",
   "action": "add",
   "ro": "ráp lûuk",
   "kind": "word",
   "category": "日常の動作",
   "frequency": 5,
   "senses": [
    {
     "sourceSense": 1,
     "ja": "子どもを迎えに行く",
     "en": "to pick up one’s child",
     "pos": "動詞",
     "use": "よく使う意味",
     "registerTags": [],
     "speechStyle": "標準語（口語限定ではない）",
     "example": {
      "th": "แม่ไปรับลูกที่โรงเรียนทุกวัน",
      "ro": "mɛ̂ɛ pai ráp lûuk thîi roong riian thúk wan",
      "ja": "母は毎日学校へ子どもを迎えに行く。",
      "en": "The mother picks up her child at school every day.",
      "origin": "authored"
     }
    },
    {
     "sourceSense": 2,
     "ja": "（相手の提案・発言を）受けて応じる・引き継いで動く",
     "en": "to take up (someone's proposal or cue) and act on it",
     "pos": "動詞",
     "use": "よく使う別の意味",
     "registerTags": [],
     "speechStyle": "標準語（口語限定ではない）",
     "example": {
      "th": "รัฐบาลรับลูกข้อเสนอของประชาชนทันที",
      "ro": "rát thà baan ráp lûuk khɔ̂ɔ sà nə̌ə khɔ̌ɔng prà chaa chon than thii",
      "ja": "政府は市民の提案をすぐに受けて動いた。",
      "en": "The government promptly took up the public's proposal.",
      "origin": "authored"
     }
    }
   ]
  }
