 {
  "id": "tl-57355",
  "verdict": "fix",
  "issues": [
   "noteの「語調をそろえるために ท่า を添えた」は根拠が不確か（ท่า は水浴びする船着き場の意とされる）ため、説明を重ね言葉という事実のみに修正"
  ],
  "fixed": {
   "id": "tl-57355",
   "th": "อาบน้ำอาบท่า",
   "action": "add",
   "ro": "àap náam àap thâa",
   "kind": "expression",
   "category": "日常の動作",
   "frequency": 3,
   "senses": [
    {
     "sourceSense": 1,
     "ja": "風呂に入って身支度する・体を洗ってさっぱりする",
     "en": "to bathe and freshen up",
     "pos": "動詞",
     "use": "よく使う意味",
     "registerTags": [
      "colloquial"
     ],
     "speechStyle": "口語",
     "note": "อาบน้ำ（シャワーを浴びる）を言葉を重ねて言う口語の言い方（重ね言葉）。",
     "example": {
      "th": "กลับบ้านไปอาบน้ำอาบท่าก่อน",
      "ro": "klàp bâan pai àap náam àap thâa kɔ̀ɔn",
      "ja": "先に家に帰って風呂に入ってくる。",
      "en": "I'll go home and freshen up first.",
      "origin": "authored"
     }
    }
   ]
  }
 },
