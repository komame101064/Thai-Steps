  "id": "tl-53726",
  "verdict": "fix",
  "issues": [
   "読み dii prèet chan は綴り（เปรส＝低声長母音、ชัน＝平声）どおりで妥当と判断し維持",
   "noteのカタカナ「ディープレッチャン」は不正確なため、異綴り ดีเปรสชั่น と話し言葉の下降調 chân の説明に差し替え"
  ],
  "fixed": {
   "id": "tl-53726",
   "th": "พายุดีเปรสชัน",
   "action": "add",
   "ro": "phaa yú dii prèet chan",
   "kind": "word",
   "category": "自然・天気・色",
   "frequency": 3,
   "senses": [
    {
     "sourceSense": 1,
     "ja": "熱帯低気圧",
     "en": "tropical depression",
     "pos": "名詞",
     "use": "よく使う意味",
     "registerTags": [],
     "speechStyle": "標準語（口語限定ではない）",
     "example": {
      "th": "พายุดีเปรสชันทำให้ภาคใต้มีฝนตกหนัก",
      "ro": "phaa yú dii prèet chan tham hâi phâak tâi mii fǒn tòk nàk",
      "ja": "熱帯低気圧のせいで南部は大雨になっています。",
      "en": "The tropical depression is bringing heavy rain to the south.",
      "origin": "authored"
     }
    }
   ],
   "note": "ดีเปรสชั่น とも書かれ、話し言葉では最後の音節を下降調（chân）で発音することも多い。"
  }
