   "action": "add",
   "ro": "phûu sɔ̀ɔp ban chii",
   "kind": "word",
   "category": "仕事・学習",
   "frequency": 2,
   "senses": [
    {
     "sourceSense": 1,
     "ja": "会計監査人（会社の会計を監査する公認の監査人）",
     "en": "auditor",
     "pos": "名詞",
     "use": "よく使う意味",
     "registerTags": [
      "formal"
     ],
     "speechStyle": "改まった表現",
     "example": {
