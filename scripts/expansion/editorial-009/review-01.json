   "kind": "word",
   "category": "体・健康",
   "frequency": 5,
   "senses": [
    {
     "sourceSense": 1,
     "ja": "入院する",
     "en": "to be in hospital",
     "pos": "動詞",
     "use": "よく使う意味",
     "registerTags": [],
     "speechStyle": "標準語（口語限定ではない）",
     "example": {
      "th": "พ่อป่วยต้องนอนโรงพยาบาลสามวัน",
