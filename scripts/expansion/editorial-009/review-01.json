   "kind": "word",
   "category": "体・健康",
   "frequency": 3,
   "senses": [
    {
     "sourceSense": 1,
     "ja": "応急手当て（をする）",
     "en": "first aid; to give first aid",
     "pos": "動詞",
     "use": "よく使う意味",
     "registerTags": [
      "formal"
     ],
     "speechStyle": "改まった表現",
     "example": {
