 {
  "id": "tl-53849",
  "verdict": "fix",
  "issues": [
   "en の Cavendish banana は品種を断定しすぎ（กล้วยหอม は香りのよい大型種の総称）。一般化"
  ],
  "fixed": {
   "id": "tl-53849",
   "th": "กล้วยหอม",
   "action": "add",
   "ro": "klûuai hɔ̌ɔm",
   "kind": "word",
   "category": "食べ物・飲み物",
   "frequency": 4,
   "senses": [
    {
     "sourceSense": 1,
     "ja": "バナナ（日本でよく見る大型の品種）",
     "en": "banana (large sweet variety, e.g. Cavendish)",
     "pos": "名詞",
     "use": "よく使う意味",
     "registerTags": [],
     "speechStyle": "標準語（口語限定ではない）",
     "example": {
      "th": "ฉันกินกล้วยหอมเป็นอาหารเช้า",
      "ro": "chǎn kin klûuai hɔ̌ɔm pen aa hǎan cháao",
      "ja": "私は朝ごはんにバナナを食べる。",
      "en": "I eat a banana for breakfast.",
      "origin": "authored"
     }
    }
   ],
   "note": "タイには多くの品種があり、กล้วย だけでは小型の品種を指すことも多い。"
  }
 },
