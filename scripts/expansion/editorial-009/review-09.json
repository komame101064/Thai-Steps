  ],
  "fixed": {
   "id": "tl-53856",
   "th": "นมเย็น",
   "action": "add",
   "ro": "nom yen",
   "kind": "word",
   "category": "食べ物・飲み物",
   "frequency": 3,
   "senses": [
    {
     "sourceSense": 1,
     "ja": "ピンクミルク（赤いシロップ入りの甘い冷たい牛乳）",
     "en": "pink milk (iced milk with red syrup)",
     "pos": "名詞",
     "use": "よく使う意味",
     "registerTags": [],
     "speechStyle": "標準語（口語限定ではない）",
