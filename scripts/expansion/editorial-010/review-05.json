  "id": "tl-54584",
  "verdict": "fix",
  "issues": [
   "อาร์ต の声調：中子音＋長母音＋死音節（ต）なので低声 àat（家の表記 การ์ด kàat・รีสอร์ต sɔ̀ɔt と同様）。見出しと例文のroを修正"
  ],
  "fixed": {
   "id": "tl-54584",
   "th": "อาร์ต",
   "action": "add",
   "ro": "àat",
   "kind": "word",
   "category": "趣味・メディア",
   "frequency": 3,
   "senses": [
    {
     "sourceSense": 1,
     "ja": "アートっぽい・芸術的な",
     "en": "arty, artistic",
     "pos": "形容詞・状態語",
     "use": "よく使う意味",
     "registerTags": [
      "colloquial"
     ],
     "speechStyle": "口語",
     "example": {
      "th": "ร้านกาแฟนี้แต่งร้านอาร์ตมาก",
      "ro": "ráan kaa fɛɛ níi tɛ̀ng ráan àat mâak",
      "ja": "このカフェは内装がとてもアートっぽい。",
      "en": "This café is decorated in a very arty way.",
      "origin": "authored"
     }
    }
   ],
   "note": "英語 art から。名詞「芸術」のほか、口語で「おしゃれで芸術っぽい」の意味でも使う。"
  }
