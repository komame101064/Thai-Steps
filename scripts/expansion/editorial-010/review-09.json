  ],
  "fixed": {
   "id": "tl-54986",
   "th": "บอร์ดดิ้งพาส",
   "action": "add",
   "ro": "bɔ̀ɔt dîng pháat",
   "kind": "word",
   "category": "移動・道案内",
   "frequency": 2,
   "senses": [
    {
     "sourceSense": 1,
     "ja": "搭乗券",
     "en": "boarding pass",
     "pos": "名詞",
     "use": "よく使う意味",
     "registerTags": [],
     "speechStyle": "標準語（口語限定ではない）",
