 {
  "id": "tl-25705",
  "verdict": "fix",
  "issues": [
   "sense2のja「タイの小型シンバル」は不正確（ฉาบは ฉิ่ง より大きいシンバル）→「チャープ（タイのシンバル）」に修正"
  ],
  "fixed": {
   "id": "tl-25705",
   "th": "ฉาบ",
   "action": "add",
   "ro": "chàap",
   "kind": "word",
   "category": "一般語彙",
   "senses": [
    {
     "sourceSense": 1,
     "ja": "塗る・上塗りする（しっくい・コーティングなど）",
     "en": "to coat, plaster, glaze",
     "pos": "動詞",
     "use": "よく使う意味",
     "registerTags": [],
     "speechStyle": "標準語（口語限定ではない）",
     "note": "กล้วยฉาบ（糖衣をからめたバナナチップス）のように食べ物にも使う。",
     "example": {
      "th": "ช่างกำลังฉาบปูนผนังบ้าน",
      "ro": "châang kam lang chàap puun phà nǎng bâan",
      "ja": "職人が家の壁にモルタルを塗っています。",
      "en": "The worker is plastering the walls of the house.",
      "origin": "authored"
     }
    },
    {
     "sourceSense": 2,
     "ja": "チャープ（タイのシンバル）",
     "en": "(Thai) cymbals",
     "pos": "名詞",
     "use": "よく使う別の意味",
     "registerTags": [],
     "speechStyle": "標準語（口語限定ではない）",
     "example": {
      "th": "เขาตีฉาบในวงดนตรีไทย",
      "ro": "khǎo tii chàap nai wong don trii thai",
      "ja": "彼はタイ音楽の楽団でチャープを叩いています。",
      "en": "He plays the cymbals in a Thai music ensemble.",
      "origin": "authored"
     }
    }
   ]
  }
