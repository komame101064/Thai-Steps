  "verdict": "fix",
  "issues": [
   "ตรึก は現代では単独でほぼ使われず ตรึกตรอง の形で用いるため note を追加（読み trʉ̀k は正しい）"
  ],
  "fixed": {
   "id": "tl-25713",
   "th": "ตรึก",
   "action": "add",
   "ro": "trʉ̀k",
   "kind": "word",
   "category": "一般語彙",
   "senses": [
    {
     "sourceSense": 1,
     "ja": "よく考える・熟考する",
     "en": "to ponder, reflect",
     "pos": "動詞",
     "use": "よく使う意味",
     "registerTags": [
      "formal"
     ],
     "speechStyle": "改まった表現",
     "note": "単独ではほとんど使わず、ふつう ตรึกตรอง（熟考する）の形で使う。",
     "example": {
      "th": "เขาตรึกตรองอยู่นานก่อนตัดสินใจ",
      "ro": "khǎo trʉ̀k trɔɔng yùu naan kɔ̀ɔn tàt sǐn cai",
      "ja": "彼は決める前に長い間よく考えました。",
      "en": "He pondered for a long time before deciding.",
      "origin": "authored"
     }
    }
   ],
   "note": "現代ではほぼ ตรึกตรอง（熟考する）の形で使う。"
  }
