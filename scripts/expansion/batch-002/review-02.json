 {
  "id": "tl-24295",
  "verdict": "fix",
  "issues": [
   "機関は2015年に ราชบัณฑิตยสภา に改称済みで、現存機関のような説明は不正確。語義を過去形寄りにし、改称の注記を追加"
  ],
  "fixed": {
   "id": "tl-24295",
   "th": "ราชบัณฑิตยสถาน",
   "action": "add",
   "ro": "râat chá ban dìt tà yá sà thǎan",
   "kind": "word",
   "category": "社会・制度",
   "senses": [
    {
     "sourceSense": 1,
     "ja": "王立学士院（タイ語の標準辞書を編纂してきた機関）",
     "en": "the Royal Institute (of Thailand)",
     "pos": "名詞",
     "use": "よく使う意味",
     "registerTags": [
      "formal"
     ],
     "speechStyle": "改まった表現",
     "note": "2015年に ราชบัณฑิตยสภา に改称されたが、辞書の名前などで今も旧称をよく目にする。",
     "example": {
      "th": "ผมเคยทำงานกับท่าน สมัยที่ท่านทำงานอยู่ที่ราชบัณฑิตยสถาน",
      "ro": "phǒm khəəi tham ngaan kàp thân sà mǎi thîi thân tham ngaan yùu thîi râat chá ban dìt tà yá sà thǎan",
      "ja": "あの方が王立学士院で働いていた頃、私は一緒に仕事をしたことがあります。",
      "en": "I once worked with him when he was working at the Royal Institute.",
      "origin": "source"
     }
    }
   ],
   "note": "2015年の法改正で ราชบัณฑิตยสภา に改組・改称されたため、現在の正式名称ではない。"
  }
 },
