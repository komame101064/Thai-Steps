 {
  "id": "tl-24427",
  "verdict": "fix",
  "issues": [
   "例文は王室語 พระราชหฤทัย（国王の御心）の用例で、見出しの文語「心」の用法を示していない（tl-24288 と同じ語）。文語の用例に差し替え",
   "語義は感情としての「心」なので分類を 体・健康 から 一般語彙 に変更し、王室語形の注記を追加"
  ],
  "fixed": {
   "id": "tl-24427",
   "th": "หฤทัย",
   "action": "add",
   "ro": "hà rʉ́ thai",
   "kind": "word",
   "category": "一般語彙",
   "senses": [
    {
     "sourceSense": 1,
     "ja": "心・胸の内",
     "en": "heart, mind",
     "pos": "名詞",
     "use": "よく使う意味",
     "registerTags": [
      "literary"
     ],
     "speechStyle": "文語",
     "note": "単独ではまれで、王室語の พระราชหฤทัย（国王の御心）などの要素として使う。",
     "example": {
      "th": "เธอมอบดวงหฤทัยให้เขาแต่เพียงผู้เดียว",
      "ro": "thəə mɔ̂ɔp duuang hà rʉ́ thai hâi khǎo tɛ̀ɛ phiiang phûu diiao",
      "ja": "彼女は心を彼ただ一人にささげた。",
      "en": "She gave her heart to him alone.",
      "origin": "authored"
     }
    }
   ],
   "note": "詩・歌詞などで使う文語。国王については พระราชหฤทัย を使う。"
  }
 },
