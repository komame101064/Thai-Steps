   "senses": [
    {
     "sourceSense": 1,
     "ja": "言い寄る・口説く",
     "en": "to court, woo",
     "pos": "動詞",
     "use": "よく使う意味",
     "registerTags": [
      "literary"
     ],
     "speechStyle": "文語",
     "note": "書き言葉や เกี้ยวพาราสี の形で使い、会話では จีบ がふつう。",
     "example": {
      "th": "ชายหนุ่มพยายามเกี้ยวหญิงสาวในงานเลี้ยง",
      "ro": "chaai nùm phá yaa yaam kîiao yǐng sǎao nai ngaan líiang",
      "ja": "若い男が宴会で娘に言い寄ろうとした。",
      "en": "The young man tried to woo the young woman at the party.",
      "origin": "authored"
     }
    }
   ]
  }
