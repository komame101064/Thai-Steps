  "id": "tl-25294",
  "verdict": "fix",
  "issues": [
   "例文の日本語訳で「王室へ（ถวาย の対象）」が抜けていたので補った"
  ],
  "fixed": {
   "id": "tl-25294",
   "th": "ถวายพระพร",
   "action": "add",
   "ro": "thà wǎai phrá phɔɔn",
   "kind": "expression",
   "category": "社会・制度",
   "senses": [
    {
     "sourceSense": 1,
     "ja": "（国王・王族に）祝福の言葉を捧げる",
     "en": "to offer blessings (to royalty)",
     "pos": "動詞",
     "use": "よく使う意味",
     "registerTags": [
      "royal"
     ],
     "speechStyle": "王室の敬語",
     "note": "王族に対してだけ使う。ลงนามถวายพระพร（祝福の記帳をする）の形が多い。",
     "example": {
      "th": "ประชาชนมาลงนามถวายพระพรเป็นจำนวนมาก",
      "ro": "prà chaa chon maa long naam thà wǎai phrá phɔɔn pen cam nuuan mâak",
      "ja": "多くの人々が王室への祝福の記帳に訪れた。",
      "en": "Large numbers of people came to sign the book of blessings for the royal family.",
      "origin": "authored"
     }
    }
   ]
  }
