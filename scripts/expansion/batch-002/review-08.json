 {
  "id": "tl-25443",
  "verdict": "fix",
  "issues": [
   "ja「アソークの木」は日本語として通じない（アソークは地名を連想させる）。和名のアソカノキ・無憂樹に修正し、例文訳も合わせた。"
  ],
  "fixed": {
   "id": "tl-25443",
   "th": "อโศก",
   "action": "add",
   "ro": "à sòok",
   "kind": "word",
   "category": "自然・天気・色",
   "senses": [
    {
     "sourceSense": 1,
     "ja": "アソカノキ・無憂樹（庭や寺に植える木）",
     "en": "Asoka tree (Saraca)",
     "pos": "名詞",
     "use": "よく使う意味",
     "registerTags": [],
     "speechStyle": "標準語（口語限定ではない）",
     "note": "通常 ต้นอโศก の形で使う。",
     "example": {
      "th": "เขาปลูกต้นอโศกไว้หน้าบ้าน",
      "ro": "khǎo plùuk tôn à sòok wái nâa bâan",
      "ja": "彼は家の前にアソカノキを植えた。",
      "en": "He planted an Asoka tree in front of his house.",
      "origin": "source"
     }
    }
   ]
  }
 },
