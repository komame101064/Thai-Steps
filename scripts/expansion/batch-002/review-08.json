   "kind": "word",
   "category": "家・場所",
   "senses": [
    {
     "sourceSense": 1,
     "ja": "（果樹園などの畝の間の）溝・水路",
     "en": "ditch between raised beds",
     "pos": "名詞",
     "use": "よく使う意味",
     "registerTags": [],
     "speechStyle": "標準語（口語限定ではない）",
     "example": {
