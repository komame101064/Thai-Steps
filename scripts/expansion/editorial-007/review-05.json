   "frequency": 3,
   "senses": [
    {
     "sourceSense": 1,
     "ja": "よい一日を",
     "en": "have a nice day",
     "pos": "定型表現",
     "use": "よく使う意味",
     "registerTags": [],
     "speechStyle": "標準語（口語限定ではない）",
     "note": "英語の Have a nice day から広まった言い方で、主にメッセージ・SNSやホテル・航空会社などの接客の結びで使い、ふだんの会話や一般の店ではあまり言わない。ขอให้เป็นวันที่ดี とも言う。",
     "example": {
      "th": "ขอบคุณที่ใช้บริการ ขอให้มีวันที่ดีนะคะ",
      "ro": "khɔ̀ɔp khun thîi chái bɔɔ rí kaan khɔ̌ɔ hâi mii wan thîi dii ná khá",
      "ja": "ご利用ありがとうございました。よい一日を。",
      "en": "Thank you for using our service. Have a nice day.",
      "origin": "authored"
     }
    }
   ]
  }
