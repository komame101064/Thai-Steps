  ],
  "fixed": {
   "id": "tl-52003",
   "th": "ไม่ค่อยดี",
   "action": "add",
   "ro": "mâi khɔ̂ɔi dii",
   "kind": "expression",
   "category": "挨拶・会話",
   "frequency": 6,
   "senses": [
    {
     "sourceSense": 1,
     "ja": "あまりよくない・いまいち",
     "en": "not so good",
     "pos": "定型表現",
     "use": "よく使う意味",
     "registerTags": [],
     "speechStyle": "標準語（口語限定ではない）",
     "note": "「元気？」への返事や、体調・出来の評価に使う。",
     "example": {
      "th": "วันนี้รู้สึกไม่ค่อยดีเลย",
      "ro": "wan níi rúu sʉ̀k mâi khɔ̂ɔi dii ləəi",
      "ja": "今日はあまり気分がよくない。",
      "en": "I don't feel very good today.",
      "origin": "authored"
     }
    }
   ]
  }
