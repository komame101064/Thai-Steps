   "senses": [
    {
     "sourceSense": 1,
     "ja": "ピンパート（＝ปี่พาทย์：タイ古典音楽の合奏）",
     "en": "classical Thai ensemble",
     "pos": "名詞",
     "use": "よく使う意味",
     "registerTags": [
      "dated"
     ],
     "speechStyle": "古めの表現",
     "example": {
      "th": "วงพิณพาทย์บรรเลงเพลงไทยเดิม",
