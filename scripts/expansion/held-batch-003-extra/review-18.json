   "category": "社会・制度",
   "senses": [
    {
     "sourceSense": 1,
     "ja": "経歴・生い立ち・背景",
     "en": "background",
     "pos": "名詞",
     "use": "よく使う意味",
     "registerTags": [],
     "speechStyle": "標準語（口語限定ではない）",
     "example": {
      "th": "นักจิตวิทยาต้องศึกษาภูมิหลังของคนไข้",
      "ro": "nák cìt tà wít thá yaa tɔ̂ɔng sʉ̀k sǎa phuum lǎng khɔ̌ɔng khon khâi",
      "ja": "心理学者は患者の生い立ちを調べなければならない。",
      "en": "A psychologist must study the patient's background.",
      "origin": "authored"
     }
    }
   ]
  }
