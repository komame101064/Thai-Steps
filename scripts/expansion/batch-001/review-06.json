  "fixed": {
   "id": "tl-23048",
   "th": "แรม",
   "action": "add",
   "ro": "rɛɛm",
   "kind": "word",
   "category": "時間",
   "senses": [
    {
     "sourceSense": 1,
     "ja": "月が欠けていく期間（陰暦の月の後半）",
     "en": "waning moon period (second half of the lunar month)",
     "pos": "名詞",
     "use": "よく使う意味",
     "registerTags": [],
     "speechStyle": "標準語（口語限定ではない）",
     "example": {
      "th": "คืนนี้เป็นคืนแรม 15 ค่ำ ท้องฟ้ามืดมาก",
      "ro": "khʉʉn níi pen khʉʉn rɛɛm sìp hâa khâm thɔ́ɔng fáa mʉ̂ʉt mâak",
      "ja": "今夜は月が欠けていく期間の15日目（新月）の夜で、空がとても暗い。",
      "en": "Tonight is the 15th night of the waning moon, and the sky is very dark.",
      "origin": "authored"
     }
    },
    {
     "sourceSense": 2,
     "ja": "泊まる・夜を明かす（旅先で）",
     "en": "to stay overnight (away from home)",
     "pos": "動詞",
     "use": "よく使う別の意味",
     "registerTags": [],
     "speechStyle": "標準語（口語限定ではない）",
     "example": {
      "th": "เราพักแรมในป่าหนึ่งคืน",
      "ro": "rao phák rɛɛm nai pàa nʉ̀ng khʉʉn",
      "ja": "私たちは森の中で一晩泊まりました。",
      "en": "We stayed overnight in the forest for one night.",
      "origin": "authored"
     }
    },
    {
     "sourceSense": 3,
     "ja": "RAM・メモリ（コンピューター）",
     "en": "RAM (computer memory)",
     "pos": "名詞",
     "use": "少なめの用法",
     "registerTags": [],
     "speechStyle": "標準語（口語限定ではない）",
     "example": {
      "th": "คอมพิวเตอร์เครื่องนี้มีแรมน้อยเกินไป",
      "ro": "khɔm phiu tə̂ə khrʉ̂ʉang níi mii rɛɛm nɔ́ɔi kəən pai",
      "ja": "このパソコンはメモリが少なすぎます。",
      "en": "This computer has too little RAM.",
      "origin": "authored"
     }
    }
   ],
   "note": "「泊まる」の意味では พักแรม・ค้างแรม の形で使うのがふつう。"
  }
