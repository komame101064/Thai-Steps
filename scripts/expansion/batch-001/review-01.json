     "pos": "名詞",
     "use": "よく使う意味",
     "registerTags": [
      "literary"
     ],
     "speechStyle": "文語",
     "example": {
      "th": "ในนิทานเรื่องนี้ กุมารน้อยอาศัยอยู่ในป่ากับแม่",
