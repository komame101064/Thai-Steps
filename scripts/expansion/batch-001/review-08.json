 {
  "id": "tl-23555",
  "verdict": "fix",
  "issues": [
   "語義1の例文のroで น้ำมนต์ は複合語なので náam mon ではなく nám mon（辞書の表記規則に合わせる）"
  ],
  "fixed": {
   "id": "tl-23555",
   "th": "สิริ",
   "action": "add",
   "ro": "sì rì",
   "kind": "word",
   "category": "一般語彙",
   "senses": [
    {
     "sourceSense": 1,
     "ja": "吉祥・めでたさ・幸運",
     "en": "auspiciousness, good fortune",
     "pos": "名詞",
     "use": "よく使う意味",
     "registerTags": [
      "formal"
     ],
     "speechStyle": "改まった表現",
     "example": {
      "th": "เขาไปรดน้ำมนต์เพื่อเป็นสิริมงคลแก่ตัว",
      "ro": "khǎo pai rót nám mon phʉ̂ʉa pen sì rì mong khon kɛ̀ɛ tuua",
      "ja": "あの人は縁起をかついで聖水をかけてもらいに行きました。",
      "en": "He went to be sprinkled with holy water for good fortune.",
      "origin": "source"
     },
     "note": "ふつう สิริมงคล（吉祥）のような複合語で使います。"
    },
    {
     "sourceSense": 2,
     "ja": "合計して〜になる（享年など）",
     "en": "to total, amount to (esp. age at death)",
     "pos": "動詞",
     "use": "少なめの用法",
     "registerTags": [
      "formal"
     ],
     "speechStyle": "改まった表現",
     "example": {
      "th": "ท่านตายด้วยโรคหัวใจ สิริอายุได้ 67 ปี",
      "ro": "thân taai dûuai rôok hǔua cai sì rì aa yú dâai hòk sìp cèt pii",
      "ja": "その方は心臓病で亡くなり、享年67歳でした。",
      "en": "He died of heart disease at the age of 67.",
      "origin": "source"
     }
    }
   ]
  }
 },
