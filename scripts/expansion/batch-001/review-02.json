 {
  "id": "tl-21820",
  "verdict": "fix",
  "issues": [
   "語義2の例文の和訳「前歯は少し歯並びが曲がっています」が不自然な日本語だったため修正。"
  ],
  "fixed": {
   "id": "tl-21820",
   "th": "เก",
   "action": "add",
   "ro": "kee",
   "kind": "word",
   "category": "性質・状態",
   "senses": [
    {
     "sourceSense": 1,
     "ja": "素行が悪い・不良の",
     "en": "delinquent, unruly, badly behaved",
     "pos": "形容詞・状態語",
     "use": "よく使う意味",
     "registerTags": [],
     "speechStyle": "標準語（口語限定ではない）",
     "example": {
      "th": "เขาเคยเป็นเด็กเกตอนเรียนมัธยม",
      "ro": "khǎo khəəi pen dèk kee tɔɔn riian mát thá yom",
      "ja": "あの人は中学・高校のころ不良でした。",
      "en": "He used to be a delinquent kid in secondary school.",
      "origin": "authored"
     }
    },
    {
     "sourceSense": 2,
     "ja": "（歯・脚などが）曲がっている・歪んでいる",
     "en": "crooked, out of line (teeth, legs)",
     "pos": "形容詞・状態語",
     "use": "よく使う別の意味",
     "registerTags": [],
     "speechStyle": "標準語（口語限定ではない）",
     "example": {
      "th": "ฟันหน้าของเขาเกนิดหน่อย",
      "ro": "fan nâa khɔ̌ɔng khǎo kee nít nɔ̀ɔi",
      "ja": "あの人の前歯は少し曲がって生えています。",
      "en": "His front teeth are a little crooked.",
      "origin": "authored"
     }
    }
   ]
  }
