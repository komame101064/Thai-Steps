 {
  "id": "tl-22817",
  "verdict": "fix",
  "issues": [
   "見出し語と例文のroで เจ้า が câo になっている。辞書では単独の เจ้า は câao、พระเจ้า は phrá câao（原典ヒントも長母音）なので câao に修正。"
  ],
  "fixed": {
   "id": "tl-22817",
   "th": "พระผู้เป็นเจ้า",
   "action": "add",
   "ro": "phrá phûu pen câao",
   "kind": "word",
   "category": "社会・制度",
   "senses": [
    {
     "sourceSense": 1,
     "ja": "神・主（キリスト教やヒンドゥー教などの）",
     "en": "God, the Lord",
     "pos": "名詞",
     "use": "よく使う意味",
     "registerTags": [
      "formal"
     ],
     "speechStyle": "改まった表現",
     "example": {
      "th": "ชาวคริสต์เชื่อในพระผู้เป็นเจ้า",
      "ro": "chaao khrít chʉ̂ʉa nai phrá phûu pen câao",
      "ja": "キリスト教徒は神を信じています。",
      "en": "Christians believe in God.",
      "origin": "authored"
     }
    }
   ]
  }
 },
