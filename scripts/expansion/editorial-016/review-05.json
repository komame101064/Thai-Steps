  ],
  "fixed": {
   "id": "tl-60141",
   "th": "แจ็กพอต",
   "action": "add",
   "ro": "cɛ̀k phɔ́t",
   "kind": "word",
   "category": "スラング｜友達の日常",
   "adult": false,
   "tags": [
    "colloquial",
    "slang"
   ],
   "frequency": 4,
   "senses": [
    {
     "sourceSense": 1,
     "ja": "（運悪く）悪いことに当たること・貧乏くじ（โดนแจ็กพอต・ถูกแจ็กพอตの形で）",
     "pos": "名詞",
     "speechStyle": "口語・スラング",
     "note": "宝くじの「ジャックポット（大当たり）」から。病気・予期せぬ妊娠・取り締まりなど悪いことに自分だけ当たったとき、冗談めかしてโดนแจ็กพอตと言う。本来の「大当たり」の意味でも使う。แจ็คพอตとも書く。",
     "example": {
      "th": "ไปเที่ยวกันห้าคน แต่ฉันโดนแจ็กพอตเป็นไข้หวัดคนเดียว",
      "ro": "pai thîiao kan hâa khon tɛ̀ɛ chǎn doon cɛ̀k phɔ́t pen khâi wàt khon diiao",
      "ja": "5人で旅行したのに、運悪く私だけ風邪を引いた。",
      "context": "旅行の後で友人に近況を話す",
      "origin": "authored"
     }
    }
   ]
  }
