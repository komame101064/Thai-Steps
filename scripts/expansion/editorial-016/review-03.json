  "id": "tl-52428",
  "verdict": "fix",
  "issues": [
   "語義・注記：วันพระใหญ่ は本来、満月・新月の仏日（陰暦8日の วันพระเล็ก に対する）。「重要な仏教祭日を指す」とした説明を修正"
  ],
  "fixed": {
   "id": "tl-52428",
   "th": "วันพระใหญ่",
   "action": "add",
   "ro": "wan phrá yài",
   "kind": "word",
   "category": "社会・制度",
   "frequency": 2,
   "senses": [
    {
     "sourceSense": 1,
     "ja": "大きな仏日（月に2回の満月・新月の仏日）",
     "en": "major Buddhist holy day (full-moon / new-moon day)",
     "pos": "名詞",
     "use": "よく使う意味",
     "registerTags": [],
     "speechStyle": "標準語（口語限定ではない）",
     "example": {
      "th": "วันพระใหญ่คนไทยนิยมไปทำบุญที่วัด",
      "ro": "wan phrá yài khon thai ní yom pai tham bun thîi wát",
      "ja": "大きな仏日には、タイ人はよくお寺へ功徳を積みに行く。",
      "en": "On major Buddhist holy days, Thais often go to make merit at temples.",
      "origin": "authored"
     }
    }
   ],
   "note": "วันพระ のうち満月と新月の日を指し、上弦・下弦（陰暦8日）の日は วันพระเล็ก という。マーカブーチャーなどの仏教祭日を指して言うこともある。"
  }
 },
