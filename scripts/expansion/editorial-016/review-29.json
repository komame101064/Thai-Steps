  "issues": [
   "สาแก่ใจは主に「〜ให้สาแก่ใจ（気が済むまで・思う存分）」の形で使い、「ざまあみろ」の場面ではสะใจ（既存tl-60268）が自然。例文をその型に差し替え、注記を追加"
  ],
  "fixed": {
   "id": "tl-50554",
   "th": "สาแก่ใจ",
   "action": "add",
   "ro": "sǎa kɛ̀ɛ cai",
   "kind": "word",
   "category": "性質・状態",
   "frequency": 4,
   "senses": [
    {
     "sourceSense": 1,
     "ja": "胸がすく・気が済む（相手の失敗などに）",
     "en": "satisfied, gratified (esp. seeing someone get their due)",
     "pos": "形容詞・状態語",
     "use": "よく使う意味",
     "registerTags": [],
     "speechStyle": "標準語（口語限定ではない）",
     "example": {
      "th": "เขาร้องไห้ให้สาแก่ใจแล้วก็หลับไป",
      "ro": "khǎo rɔ́ɔng hâi hâi sǎa kɛ̀ɛ cai lɛ́ɛo kɔ̂ɔ làp pai",
      "ja": "彼は気が済むまで泣いてから眠った。",
      "en": "He cried to his heart's content and then fell asleep.",
      "origin": "authored"
     }
    }
   ],
   "note": "「〜ให้สาแก่ใจ（気が済むまで〜する）」の形が多い。人の失敗を見て「ざまあみろ」と思う口語はふつうสะใจ。"
  }
 },
