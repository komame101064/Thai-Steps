  "fixed": {
   "id": "tl-55382",
   "th": "หยากไย่",
   "action": "add",
   "ro": "yàak yâi",
   "kind": "word",
   "category": "家・場所",
   "frequency": 2,
   "senses": [
    {
     "sourceSense": 1,
     "ja": "（ほこりのついた）古いクモの巣",
     "en": "dusty old cobwebs",
     "pos": "名詞",
     "use": "よく使う意味",
     "registerTags": [],
     "speechStyle": "標準語（口語限定ではない）",
     "example": {
      "th": "เพดานห้องเก่ามีหยากไย่เต็มไปหมด",
      "ro": "phee daan hɔ̂ɔng kào mii yàak yâi tem pai mòt",
      "ja": "古い部屋の天井はほこりまみれのクモの巣だらけだ。",
      "en": "The ceiling of the old room is full of dusty cobwebs.",
      "origin": "authored"
     }
    }
   ],
   "note": "ふつう ใยแมงมุม（クモの巣）にほこりが絡んだものを指し、掃除の話題で使う。"
  }
