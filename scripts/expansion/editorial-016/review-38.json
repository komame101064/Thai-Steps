   "frequency": 2,
   "senses": [
    {
     "sourceSense": 1,
     "ja": "身一つで・ほとんど何も持たずに",
     "en": "with nothing but the bare essentials, starting from nothing",
     "pos": "定型表現",
     "use": "よく使う意味",
     "registerTags": [],
     "speechStyle": "標準語（口語限定ではない）",
     "example": {
      "th": "พ่อเริ่มต้นชีวิตในเมืองจากเสื่อผืนหมอนใบ",
      "ro": "phɔ̂ɔ rə̂əm tôn chii wít nai mʉʉang càak sʉ̀ʉa phʉ̌ʉn mɔ̌ɔn bai",
      "ja": "父は町で身一つから暮らしを始めた。",
      "en": "My father started his life in the city with nothing but a mat and a pillow.",
      "origin": "authored"
     }
    }
   ],
   "note": "「ござ一枚と枕一つ」のイメージ。裸一貫から成功した人の話でよく使う。"
