   "frequency": 5,
   "senses": [
    {
     "sourceSense": 1,
     "ja": "まだましだ・（〜だけでも）まだよかった",
     "en": "it's lucky (that), at least",
     "pos": "定型表現",
     "use": "よく使う意味",
     "registerTags": [],
     "speechStyle": "標準語（口語限定ではない）",
     "example": {
      "th": "รถพังแต่ยังดีที่คนไม่เป็นอะไร",
      "ro": "rót phang tɛ̀ɛ yang dii thîi khon mâi pen à rai",
      "ja": "車は壊れたが、人が無事だったのはまだよかった。",
      "en": "The car was wrecked, but at least nobody was hurt.",
      "origin": "authored"
     }
    }
   ],
   "note": "ยังดีที่〜（〜なのが不幸中の幸いだ）の形でよく使う。"
  }
