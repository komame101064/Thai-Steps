     "sourceSense": 1,
     "ja": "（学校の成績の）授業態度点",
     "en": "marks for attitude and behavior (in school grading)",
     "pos": "名詞",
     "use": "よく使う意味",
     "registerTags": [],
     "speechStyle": "標準語（口語限定ではない）",
