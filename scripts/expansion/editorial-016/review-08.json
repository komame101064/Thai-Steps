  "verdict": "fix",
  "issues": [
   "例文「ร้านไม่มีทอนแบงก์พัน」の語順が不自然なため、店員の自然な言い方に差し替え"
  ],
  "fixed": {
   "id": "tl-50299",
   "th": "ไม่มีทอน",
   "action": "add",
   "ro": "mâi mii thɔɔn",
   "kind": "expression",
   "category": "お金・買い物",
   "frequency": 4,
   "senses": [
    {
     "sourceSense": 1,
     "ja": "お釣りがない（店がお釣りを出せない）",
     "en": "no change (cannot give change)",
     "pos": "定型表現",
     "use": "よく使う意味",
     "registerTags": [
      "colloquial"
     ],
     "speechStyle": "口語",
     "example": {
      "th": "แบงก์พันไม่มีทอนนะคะ ขอแบงก์ย่อยได้ไหมคะ",
      "ro": "bɛ́ng phan mâi mii thɔɔn ná khá khɔ̌ɔ bɛ́ng yɔ̂ɔi dâai mǎi khá",
      "ja": "千バーツ札だとお釣りがないんです。細かいお札はありますか？",
      "en": "We don't have change for a 1,000-baht note. Do you have smaller notes?",
      "origin": "authored"
     }
    }
   ],
   "note": "店員が言うことが多い。客が「お釣りはありますか」と聞くときはมีทอนไหมと言う。"
  }
 },
