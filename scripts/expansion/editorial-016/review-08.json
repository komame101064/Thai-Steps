   "kind": "word",
   "category": "移動・道案内",
   "frequency": 2,
   "senses": [
    {
     "sourceSense": 1,
     "ja": "積載車（故障車を荷台に載せて運ぶレッカー車）",
     "en": "flatbed tow truck",
     "pos": "名詞",
     "use": "よく使う意味",
     "registerTags": [
      "colloquial"
     ],
     "speechStyle": "口語",
     "example": {
      "th": "รถเสียกลางทาง ต้องเรียกรถสไลด์มาลาก",
      "ro": "rót sǐia klaang thaang tɔ̂ɔng rîiak rót sà lai maa lâak",
      "ja": "車が途中で故障したので、積載車を呼んで運んでもらわなければならなかった。",
